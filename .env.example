# DashScope 兼容 OpenAI 接口（与开题一致：Qwen2.5-7B-Instruct）
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 生成 / 校验基座（开题为 qwen2.5-7b-instruct；若未开通可用 qwen3.8-max）
GEN_MODEL=qwen3.8-max
VERIFY_MODEL=qwen3.8-max
GEN_MAX_TOKENS=350

# 评测 judge
JUDGE_MODEL=qwen3.8-max
